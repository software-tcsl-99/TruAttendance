{
  "expo": {
    "name": "Geo-Track HRMS System",
    "slug": "geo-track-hrms-system",
    "scheme": "trackflow",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adesh.trackflow",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app requires location access in the foreground to verify your punch-in/out range relative to the office geofence.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app requires location access in the background to log your route and verify compliance with office geofencing rules while you are clocked in.",
        "NSLocationAlwaysUsageDescription": "This app requires location access in the background to log your route and verify compliance with office geofencing rules while you are clocked in.",
        "NSCameraUsageDescription": "This app requires camera access to take selfies during punch-in and punch-out for identity verification.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access to allow uploading profile images.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.adesh.trackflow",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCP_wcD-7ZCxw_4DbVmiANpp5FE1Bk0JiI"
        }
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "FOREGROUND_SERVICE_REMOTE_MESSAGING",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-camera",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app requires location access in the foreground and background to log your route and verify compliance with office geofencing rules while you are clocked in.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "8abf158f-1740-4430-96a6-4885a68820ad"
      }
    },
    "owner": "sakshi_272817",
    "updates": {
      "url": "https://u.expo.dev/8abf158f-1740-4430-96a6-4885a68820ad",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.0.1"
  }
}